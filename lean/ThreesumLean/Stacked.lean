import ThreesumLean.Basic

/-!
# Folded (stacked) all-edges Exact Triangle: kernel checks of stacked_cert.py (generated by gen_stacked.py)

Theorem A' of `proofs/stacked.md`: with `sigma = min(eps*gamma, eps*(1/2 - q))`, the
folded residue instances (Lemma 3.2') give deterministic all-edges Exact Triangle, (min,+)-product and APSP in
`n^{3 - sigma + o(1)}` under three conditions, `eps (E + gamma - 1/4) < 1` (the Theorem O hypothesis of the folded
instances; it was `eps (E + gamma) < 1` before the fold), `2 + eps < 3 - sigma` (dense instance building) and
`sigma < eps/2` (per-slot sums).

What is checked here, at the script's exact rational points and with its printed values:
- `CertStacked`: one field per check of `stacked_cert.py`'s `cert` (c > 10, 0 < theta < 0.9, eps > 0, both terms
  positive, the three conditions above), plus `sigma >= s0` and the APSP lines `3 - sigma <= bA` and
  `3 - sigma < oA` (the `O(n^e)` line, strict).
- `stacked_T4` (exact count + pruned encoding, after ImprovedExponents): `sigma >= 0.004057248470`, APSP
  `<= 2.995942752`, `O(n^2.995943)`. `stacked_T1` (paper lemmas): `sigma >= 0.003760515625`, `O(n^2.996240)`.
- `*_sigma_le`: an upper bound on sigma (used by the controls and by `KClique.lean`).
- Negative controls, each proved false: `s0` at the next grid point, `bA` and `oA` one unit lower, and theta moved
  by `10^-6` (sigma is maximal near `gamma = 1/2 - q`, so either move loses). `*_unfolded_enc_neg`: `eps E > 1` at
  both points, so the unfolded Lemma 3.2 of proofs/derandomisation.md (whose encoding term is `1 - eps E`) does not hold there and
  these exponents rest on Lemma 3.2' alone (the point the review asked to record).
The logs are bounded only through `log_mem` (Basic.lean): each atom is a positive rational, bounded by the series
with a kernel-checked rational remainder. No `native_decide`, no `sorry`, no new axiom.

What is NOT checked (paper proofs, `proofs/stacked.md` and `proofs/derandomisation.md`):
- Lemma 3.2' itself: that the folded product `X Y` has entry `N_M(a, b, k)` at the decoded position, that the
  positions are distinct and in range, and its time bound.
- That the folded instances satisfy Theorem O's hypothesis whenever `eps (E + gamma - 1/4) < 1` (the monotonicity
  of `(v + u)/(1 + u/2)` and the uniform `eps0`), and Theorem O itself (the paper's cor:tradeoff, and the exact box
  count and pruned encoding of ImprovedExponents for the T4 tier).
- That Lemmas 3.3 to 3.7 and Section 4 of proofs/derandomisation.md hold unchanged with Lemma 3.2', and the reductions from all-edges
  Exact Triangle to (min,+) and APSP.
- The closed forms gamma, q, E as the exponents of those counts (Appendix A). Lean checks them only as formulas.
- That no other point does better; the parameter search is not part of the repository.
-/

set_option maxRecDepth 100000
set_option maxHeartbeats 4000000

open Real

namespace TS

/-- The two terms of the folded route: boxes `eps*gamma` and queries `eps*(1/2 - q)`. There is no encoding term:
the fold moves it into the condition `eps (E + gamma - 1/4) < 1`. -/
noncomputable def stTerms (th eps g : ℝ) : List ℝ := [eps * g, eps * (1 / 2 - qExp th)]

/-- `sigma = min(eps*gamma, eps*(1/2 - q))` (stacked_cert.py, `bmin(t_box, t_qry)`). -/
noncomputable def sigStacked (th eps g : ℝ) : ℝ := minl (stTerms th eps g)

/-- stacked_cert.py `cert`: every check it makes, then `sigma >= s0`, det all-edges ET/(min,+)/APSP
`3 - sigma <= bA`, and the `O(n^e)` line `3 - sigma < oA`. -/
structure CertStacked (c th eps g E s0 bA oA : ℝ) : Prop where
  c_gt : 10 < c
  th_pos : 0 < th
  th_lt : th < 9 / 10
  eps_pos : 0 < eps
  terms_pos : ∀ t ∈ stTerms th eps g, 0 < t
  fold : eps * (E + g - 1 / 4) < 1
  building : 2 + eps < 3 - sigStacked th eps g
  bookkeeping : sigStacked th eps g < eps / 2
  saving : s0 ≤ sigStacked th eps g
  apsp : 3 - sigStacked th eps g ≤ bA
  apsp_O : 3 - sigStacked th eps g < oA

lemma CertStacked.mk' {c th eps g E s0 bA oA : ℝ} (h1 : 10 < c) (h2 : 0 < th) (h3 : th < 9 / 10)
    (h4 : 0 < eps) (hf : eps * (E + g - 1 / 4) < 1) (hbuild : 2 + eps + eps * g < 3) (hbook : eps * g < eps / 2)
    (hlow : ∀ t ∈ stTerms th eps g, s0 ≤ t) (hs0 : 0 < s0) (hbA : 3 - s0 ≤ bA) (hoA : 3 - s0 < oA) :
    CertStacked c th eps g E s0 bA oA := by
  have hS : s0 ≤ sigStacked th eps g := le_minl (by simp [stTerms]) hlow
  have hU : sigStacked th eps g ≤ eps * g := minl_le (by simp [stTerms])
  exact ⟨h1, h2, h3, h4, fun t ht => by linarith [hlow t ht], hf, by linarith, by linarith, hS, by linarith,
    by linarith⟩

