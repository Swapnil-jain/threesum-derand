/-- Control: the k = 12 exponent one unit lower (11.984957) fails. -/
theorem kclique_T1_fails_next_12 : ¬ (kcExp 12 (sigStacked (5613801/50000000) (54758043/1000000000) (gammaRho (220136043/10000000) (5613801/50000000))) ≤ (11984957/1000000)) := by
  intro h
