import ThreesumLean.Stacked

/-!
# k-Clique through the folded Exact Triangle: kernel checks of stacked_cert.py (generated by gen_stacked.py)

`proofs/stacked.md`, Corollary E: the paper's cor:kclique (its NP85 reduction, verbatim) turns an Exact Triangle
algorithm in `n^{3 - sigma + o(1)}` into Zero-, Min- and Max-Weight k-Clique in `n^{k - floor(k/3) sigma + o(1)}`.
With Theorem A'(b) (Stacked.lean) this is deterministic.

What is checked here, for both tiers, with sigma the certified saving of Stacked.lean at the same rational point
(`stacked_T4.saving` and `stacked_T4_sigma_le`, so no log is bounded again):
- `kclique_*_uniform`: for EVERY `k >= 3`, `k - floor(k/3) sigma < k - s6 floor(k/3)` with `s6` the saving
  rounded down to 6 dp (0.004057, or 0.003760 for the paper lemmas). This strict inequality is what lets the
  `n^{o(1)}` be absorbed into `O(n^{k - s6 floor(k/3)})`.
- `kclique_*_table`: the printed exponents for k = 3..12, each `k - floor(k/3) sigma <=` the printed value.
- `conv3sum_via_ET_*`: the Convolution-3SUM route through Exact Triangle on `n^{1/2}` vertices, `2 - sigma/2`, is at
  most the printed value and worse than det 3SUM's 1.996001 (1.996291 for the paper lemmas), so the fold gives
  Convolution-3SUM nothing.
- Negative controls, each proved false: the uniform form at `s6` plus one unit, and the k = 12 exponent one unit
  lower.

What is NOT checked (paper proofs): the reduction of cor:kclique (n^t Exact Triangle instances with
`N = n^{floor(k/3)}` vertices per part and weights `<= N^{2 nu}`; Min/Max through VW13 Thm 3.3 with `O(log^2)` calls),
the linear-time deterministic reduction from Convolution-3SUM to 3SUM, the det 3SUM bound 1.996001 itself (Points.lean
checks its certificate, not its proof), and everything listed as not checked in Stacked.lean.
-/

open Real

namespace TS

/-- The k-Clique exponent from an Exact Triangle exponent `3 - sigma` (cor:kclique): `k - floor(k/3) sigma`. -/
noncomputable def kcExp (k : ℕ) (σ : ℝ) : ℝ := (k : ℝ) - ((k / 3 : ℕ) : ℝ) * σ

/-- Every `k >= 3` has `floor(k/3) >= 1`, so a saving strictly above `s` gives an exponent strictly below
`k - s floor(k/3)`. -/
lemma kcExp_lt {σ s : ℝ} (h : s < σ) {k : ℕ} (hk : 3 ≤ k) : kcExp k σ < (k : ℝ) - ((k / 3 : ℕ) : ℝ) * s := by
  have h1 : (1 : ℝ) ≤ ((k / 3 : ℕ) : ℝ) := by exact_mod_cast Nat.div_pos hk (by norm_num)
  unfold kcExp; nlinarith

/-- exact count + pruned encoding (after ImprovedExponents): det Zero/Min/Max-Weight k-Clique in O(n^(k - 0.004057 floor(k/3))) for every k >= 3. -/
theorem kclique_T4_uniform : ∀ k : ℕ, 3 ≤ k →
    kcExp k (sigStacked (11196129/100000000) (72821473/1250000000) (gammaExact (2105675159/100000000) (11196129/100000000))) < (k : ℝ) - ((k / 3 : ℕ) : ℝ) * (4057/1000000) := by
  intro k hk
  have hlo := stacked_T4.saving
  have hhi := stacked_T4_sigma_le
  exact kcExp_lt (by linarith) hk

/-- exact count + pruned encoding (after ImprovedExponents): the printed k-Clique exponents for k = 3..12 (rounded up). -/
theorem kclique_T4_table :
    kcExp 3 (sigStacked (11196129/100000000) (72821473/1250000000) (gammaExact (2105675159/100000000) (11196129/100000000))) ≤ (2995943/1000000) ∧
    kcExp 4 (sigStacked (11196129/100000000) (72821473/1250000000) (gammaExact (2105675159/100000000) (11196129/100000000))) ≤ (3995943/1000000) ∧
    kcExp 5 (sigStacked (11196129/100000000) (72821473/1250000000) (gammaExact (2105675159/100000000) (11196129/100000000))) ≤ (4995943/1000000) ∧
    kcExp 6 (sigStacked (11196129/100000000) (72821473/1250000000) (gammaExact (2105675159/100000000) (11196129/100000000))) ≤ (2995943/500000) ∧
    kcExp 7 (sigStacked (11196129/100000000) (72821473/1250000000) (gammaExact (2105675159/100000000) (11196129/100000000))) ≤ (3495943/500000) ∧
    kcExp 8 (sigStacked (11196129/100000000) (72821473/1250000000) (gammaExact (2105675159/100000000) (11196129/100000000))) ≤ (3995943/500000) ∧
    kcExp 9 (sigStacked (11196129/100000000) (72821473/1250000000) (gammaExact (2105675159/100000000) (11196129/100000000))) ≤ (8987829/1000000) ∧
    kcExp 10 (sigStacked (11196129/100000000) (72821473/1250000000) (gammaExact (2105675159/100000000) (11196129/100000000))) ≤ (9987829/1000000) ∧
    kcExp 11 (sigStacked (11196129/100000000) (72821473/1250000000) (gammaExact (2105675159/100000000) (11196129/100000000))) ≤ (10987829/1000000) ∧
    kcExp 12 (sigStacked (11196129/100000000) (72821473/1250000000) (gammaExact (2105675159/100000000) (11196129/100000000))) ≤ (2995943/250000) := by
  have hlo := stacked_T4.saving
  have hhi := stacked_T4_sigma_le
  unfold kcExp
  norm_num
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩ <;> linarith

/-- exact count + pruned encoding (after ImprovedExponents): Convolution-3SUM through Exact Triangle on n^(1/2) vertices, `2 - sigma/2 <= 1.997972`, is worse than det 3SUM's 1.996001. -/
theorem conv3sum_via_ET_T4 : 2 - (sigStacked (11196129/100000000) (72821473/1250000000) (gammaExact (2105675159/100000000) (11196129/100000000))) / 2 ≤ (499493/250000) ∧
    (1996001/1000000 : ℝ) < 2 - (sigStacked (11196129/100000000) (72821473/1250000000) (gammaExact (2105675159/100000000) (11196129/100000000))) / 2 := by
  have hlo := stacked_T4.saving
  have hhi := stacked_T4_sigma_le
  constructor <;> linarith

/-- Control: the uniform form at s6 + 1/1000000 fails (at k = 3). -/
theorem kclique_T4_uniform_fails_next : ¬ (∀ k : ℕ, 3 ≤ k →
    kcExp k (sigStacked (11196129/100000000) (72821473/1250000000) (gammaExact (2105675159/100000000) (11196129/100000000))) < (k : ℝ) - ((k / 3 : ℕ) : ℝ) * (2029/500000)) := by
  intro h
  have h3 := h 3 le_rfl
  have hlo := stacked_T4.saving
  have hhi := stacked_T4_sigma_le
  unfold kcExp at h3
  norm_num at h3
  linarith

/-- Control: the k = 12 exponent one unit lower (11.983771) fails. -/
theorem kclique_T4_fails_next_12 : ¬ (kcExp 12 (sigStacked (11196129/100000000) (72821473/1250000000) (gammaExact (2105675159/100000000) (11196129/100000000))) ≤ (11983771/1000000)) := by
  intro h
  have hlo := stacked_T4.saving
  have hhi := stacked_T4_sigma_le
  unfold kcExp at h
  norm_num at h
  linarith

/-- paper lemmas (rho boxes, full encoding): det Zero/Min/Max-Weight k-Clique in O(n^(k - 0.003760 floor(k/3))) for every k >= 3. -/
theorem kclique_T1_uniform : ∀ k : ℕ, 3 ≤ k →
    kcExp k (sigStacked (5613801/50000000) (54758043/1000000000) (gammaRho (220136043/10000000) (5613801/50000000))) < (k : ℝ) - ((k / 3 : ℕ) : ℝ) * (47/12500) := by
  intro k hk
  have hlo := stacked_T1.saving
  have hhi := stacked_T1_sigma_le
  exact kcExp_lt (by linarith) hk

/-- paper lemmas (rho boxes, full encoding): the printed k-Clique exponents for k = 3..12 (rounded up). -/
theorem kclique_T1_table :
    kcExp 3 (sigStacked (5613801/50000000) (54758043/1000000000) (gammaRho (220136043/10000000) (5613801/50000000))) ≤ (37453/12500) ∧
    kcExp 4 (sigStacked (5613801/50000000) (54758043/1000000000) (gammaRho (220136043/10000000) (5613801/50000000))) ≤ (49953/12500) ∧
    kcExp 5 (sigStacked (5613801/50000000) (54758043/1000000000) (gammaRho (220136043/10000000) (5613801/50000000))) ≤ (62453/12500) ∧
    kcExp 6 (sigStacked (5613801/50000000) (54758043/1000000000) (gammaRho (220136043/10000000) (5613801/50000000))) ≤ (5992479/1000000) ∧
    kcExp 7 (sigStacked (5613801/50000000) (54758043/1000000000) (gammaRho (220136043/10000000) (5613801/50000000))) ≤ (6992479/1000000) ∧
    kcExp 8 (sigStacked (5613801/50000000) (54758043/1000000000) (gammaRho (220136043/10000000) (5613801/50000000))) ≤ (7992479/1000000) ∧
    kcExp 9 (sigStacked (5613801/50000000) (54758043/1000000000) (gammaRho (220136043/10000000) (5613801/50000000))) ≤ (8988719/1000000) ∧
    kcExp 10 (sigStacked (5613801/50000000) (54758043/1000000000) (gammaRho (220136043/10000000) (5613801/50000000))) ≤ (9988719/1000000) ∧
    kcExp 11 (sigStacked (5613801/50000000) (54758043/1000000000) (gammaRho (220136043/10000000) (5613801/50000000))) ≤ (10988719/1000000) ∧
    kcExp 12 (sigStacked (5613801/50000000) (54758043/1000000000) (gammaRho (220136043/10000000) (5613801/50000000))) ≤ (5992479/500000) := by
  have hlo := stacked_T1.saving
  have hhi := stacked_T1_sigma_le
  unfold kcExp
  norm_num
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩ <;> linarith

/-- paper lemmas (rho boxes, full encoding): Convolution-3SUM through Exact Triangle on n^(1/2) vertices, `2 - sigma/2 <= 1.998120`, is worse than det 3SUM's 1.996291. -/
theorem conv3sum_via_ET_T1 : 2 - (sigStacked (5613801/50000000) (54758043/1000000000) (gammaRho (220136043/10000000) (5613801/50000000))) / 2 ≤ (49953/25000) ∧
    (1996291/1000000 : ℝ) < 2 - (sigStacked (5613801/50000000) (54758043/1000000000) (gammaRho (220136043/10000000) (5613801/50000000))) / 2 := by
  have hlo := stacked_T1.saving
  have hhi := stacked_T1_sigma_le
  constructor <;> linarith

/-- Control: the uniform form at s6 + 1/1000000 fails (at k = 3). -/
theorem kclique_T1_uniform_fails_next : ¬ (∀ k : ℕ, 3 ≤ k →
    kcExp k (sigStacked (5613801/50000000) (54758043/1000000000) (gammaRho (220136043/10000000) (5613801/50000000))) < (k : ℝ) - ((k / 3 : ℕ) : ℝ) * (3761/1000000)) := by
  intro h
